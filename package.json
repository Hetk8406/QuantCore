{
    "name": "indian-stock-predictor",
    "version": "1.0.0",
    "description": "Full stack stock prediction application",
    "scripts": {
        "start": "concurrently --kill-others-on-fail \"npm run backend\" \"npm run frontend\"",
        "backend": "cd backend && venv\\Scripts\\python -m uvicorn main:app --reload --host 0.0.0.0 --port 8000",
        "frontend": "cd frontend && npm run dev -- --host"
    },
    "devDependencies": {
        "concurrently": "^8.2.0"
    }
}